# SmartSpend Copilot - Environment Variables
# Copy this file to .env and fill in the real values

# Database Configuration
DB_NAME=smartspend
DB_USERNAME=root
DB_PASSWORD=your_password

# JWT Configuration (use a strong secret key in production)
JWT_SECRET=your-strong-jwt-secret-key-at-least-256-bits-long

# Gemini AI API Key
GEMINI_API_TOKEN=your_gemini_api_token
